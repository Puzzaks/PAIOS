<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Note on hardware gating: Do NOT use <uses-feature android:name="android.hardware.npu" android:required="true" />.
         Google Play Console's Device Catalog currently only maps `android.hardware.npu` to Android 17 (API 37) devices
         (excluding Pixel 8/9, Galaxy S24, and all Android 14/15/16 AICore hardware).
         AICore availability is enforced at runtime via ML Kit Prompt API `checkStatus()`, while Play Store distribution
         is gated by `minSdk = 34` and Play Console Exclusion Rules (RAM >= 8GB / SoC). -->

    <application
        android:label="PAIOS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Note: Google AICore is a system application service (declared under <queries> below),
             NOT an OS shared library (<uses-library>). Forcing <uses-library android:name="com.google.android.aicore" />
             causes Android PackageManager to fail package installation with INSTALL_FAILED_MISSING_SHARED_LIBRARY.
             AICore availability is enforced at runtime via ML Kit Prompt API checkStatus(). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".MeshOverlayActivity"
            android:theme="@style/MeshOverlayTheme"
            android:exported="true"
            android:taskAffinity="page.puzzak.paios.overlay"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.VOICE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.puzzak.m3x.mesh.ACTION_MESH_OVERLAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PaiosVoiceInteractionService"
            android:label="PAIOS Assistant"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".PaiosVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <service
            android:name=".PaiosRecognitionService"
            android:label="PAIOS Speech Recognition"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="google_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <package android:name="com.google.android.aicore" />
        <intent>
            <action android:name="com.google.android.aicore.action.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
